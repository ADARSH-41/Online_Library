<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee"
    xmlns:xsi="http://w3.org"
    xsi:schemaLocation="https://jakarta.ee https://jakarta.ee/web-app_6_0.xsd"
    version="6.0">

    <display-name>Online Library Application</display-name>

    <!-- Registers the Front Controller pattern engine for Spring MVC -->
    <servlet>
        <servlet-name>dispatcher</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>contextConfigLocation</param-name>
            <!-- Points to your Spring Bean XML configuration file -->
            <param-value>/WEB-INF/dispatcher-servlet.xml</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <!-- Maps all incoming application web traffic to Spring -->
    <servlet-mapping>
        <servlet-name>dispatcher</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>
            classpath:applicationContext-daos.xml
        </param-value>
    </context-param>

    <listener>
        <listener-class>
            org.springframework.web.context.ContextLoaderListener
        </listener-class>
    </listener>
</web-app>